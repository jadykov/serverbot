{
  // Строгая конфигурация под Node.js 20+ и ES-модули.
  // ВАЖНО: из-за "module": "NodeNext" во всех относительных импортах
  // обязательно писать расширение .js (даже если файл на диске .ts) —
  // так требует стандарт ESM. Примеры: import { config } from './config.js'
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "removeComments": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
