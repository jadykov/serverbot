# ==========================================================================
#  Пример переменных окружения. Скопируйте файл в .env и заполните значения:
#      cp .env.example .env
#  Файл .env НИКОГДА не коммитится в git (см. .gitignore).
# ==========================================================================

# --------------------------------------------------------------------------
# 1. ОБЯЗАТЕЛЬНОЕ: токен бота от @BotFather в Telegram
#    /newbot -> имя -> username -> получите строку вида 1234567890:AA...
# --------------------------------------------------------------------------
BOT_TOKEN=

# Сбрасывать ли апдейты, накопившиеся за время простоя бота (true/false).
# true — после перезапуска бот не будет отвечать на старые сообщения.
DROP_PENDING_UPDATES=true

# --------------------------------------------------------------------------
# 2. Встроенный HTTP-сервер: только эндпоинт /health для проверки живости
#    (docker healthcheck, systemd, внешний мониторинг).
#    Наружу не публикуется, домен не нужен.
# --------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# --------------------------------------------------------------------------
# 3. Google Gemini (текстовая нейросеть)
#    Ключ бесплатно: https://aistudio.google.com/apikey
#
#    По умолчанию стоит плавающий алиас gemini-flash-lite-latest: он всегда
#    указывает на актуальную lite-модель и не «протухает», когда Google
#    выводит конкретные версии из обращения.
#    Альтернативы: gemini-flash-latest (умнее, но по умолчанию «размышляет»:
#    медленнее и требует запаса maxOutputTokens), либо закреплённая версия
#    вроде gemini-3.5-flash-lite.
#    Список моделей, доступных именно вашему ключу:
#      curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#        https://generativelanguage.googleapis.com/v1beta/models
# --------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Управление «размышлениями» модели. По умолчанию (пусто) параметр не
# отправляется — это работает на любой модели. Формат зависит от поколения:
#   Gemini 2.5 — число, бюджет в токенах:  GEMINI_THINKING=0   (0 — выключить)
#   Gemini 3.x — уровень:                  GEMINI_THINKING=low
#                (minimal | low | medium | high)
# ВНИМАНИЕ: значение «не от того поколения» модель отвергнет с ошибкой
# 400 INVALID_ARGUMENT.
GEMINI_THINKING=

# Свой адрес API вместо стандартного. Нужен, только если Google отвечает
# «User location is not supported» — он блокирует IP-диапазоны многих
# хостингов. Укажите здесь адрес своего прокси в разрешённом регионе,
# например https://gemini-proxy.ваш-домен.workers.dev
# Пусто = обращаться напрямую к generativelanguage.googleapis.com
GEMINI_BASE_URL=

# Цепочки моделей: первая отвечает, остальные подхватывают при отказе
# (кончилась дневная квота, модель вывели из обращения). Перечисление
# через запятую, порядок важен.
#
# Зачем это в .env: Google регулярно переименовывает модели и закрывает
# старые версии, а точный список, доступный именно вашему ключу, виден
# только в AI Studio (https://aistudio.google.com/rate-limit). Если бот
# отвечает «модель недоступна» — поправьте здесь, пересобирать не нужно.
#
# main  — всё основное: разговор, картинки на вход, документы
# think — команда «хорошо подумай»: дневная норма маленькая
GEMINI_CHAIN_MAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
GEMINI_CHAIN_THINK=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# --------------------------------------------------------------------------
# 4. Любой OpenAI-совместимый провайдер (второй текстовый провайдер).
#    Подходят: OpenAI, OpenRouter, DeepSeek, Together, локальный Ollama и т.д.
#    Примеры BASE_URL:
#      https://api.openai.com/v1
#      https://openrouter.ai/api/v1
#      https://api.deepseek.com/v1
#      http://localhost:11434/v1        (Ollama)
#    Блок можно оставить пустым — тогда провайдер просто отключится.
# --------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------
# 5. OpenRouter — генерация картинок (команда /draw). Единственное платное
#    место в боте.
#
#    Бесплатно нарисовать нечем: у Google в колонке Free Tier все модели
#    генерации изображений помечены «Not available» — и Imagen, и нативные
#    Gemini Image. В веб-интерфейсе AI Studio картинки рисуются бесплатно,
#    но через API те же модели требуют биллинга; на этом обычно и путаются.
#
#    Ключ и баланс: https://openrouter.ai/keys
#    Пустой ключ = команда /draw просто отключится, остальной бот работает.
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модель, размер и качество. low 1024x1024 стоит около полуцента за картинку —
# на пяти долларах это порядка тысячи изображений. Точную сумму каждого вызова
# OpenRouter возвращает сам, и бот показывает её в подписи к картинке.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1-mini
OPENROUTER_IMAGE_RESOLUTION=1024x1024
OPENROUTER_IMAGE_QUALITY=low
OPENROUTER_IMAGE_FORMAT=png

# --------------------------------------------------------------------------
# 6. Прочее
# --------------------------------------------------------------------------
# Telegram ID администраторов через запятую (узнать свой: команда /whoami).
# Админы не ограничиваются рейт-лимитом и видят расширенный /status.
ADMIN_IDS=

# Ограничение частоты запросов: не более RATE_LIMIT_MAX сообщений
# за RATE_LIMIT_WINDOW_MS миллисекунд от одного пользователя.
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000

# Сколько сообщений диалога помнить в контексте (0 — не помнить)
HISTORY_LIMIT=30

# Таймаут одного запроса к нейросети, мс
AI_TIMEOUT_MS=90000

# Где хранить сессии: историю диалогов и настройки разделов форума.
# Путь относительный — считается от рабочего каталога процесса.
# ВАЖНО: в Docker этот каталог обязан лежать на томе, иначе пересоздание
# контейнера сбросит настройки всех разделов. В docker-compose том уже описан.
SESSION_DIR=data/sessions

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info
