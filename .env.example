# ==========================================================================
#  Пример переменных окружения. Скопируйте файл в .env и заполните значения:
#      cp .env.example .env
#  Файл .env НИКОГДА не коммитится в git (см. .gitignore).
# ==========================================================================

# --------------------------------------------------------------------------
# 1. ОБЯЗАТЕЛЬНОЕ: токен бота от @BotFather в Telegram
#    /newbot -> имя -> username -> получите строку вида 1234567890:AA...
# --------------------------------------------------------------------------
BOT_TOKEN=

# Сбрасывать ли апдейты, накопившиеся за время простоя бота (true/false).
# true — после перезапуска бот не будет отвечать на старые сообщения.
DROP_PENDING_UPDATES=true

# --------------------------------------------------------------------------
# 2. Встроенный HTTP-сервер: только эндпоинт /health для проверки живости
#    (docker healthcheck, systemd, внешний мониторинг).
#    Наружу не публикуется, домен не нужен.
# --------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# --------------------------------------------------------------------------
# 3. Google Gemini (текстовая нейросеть)
#    Ключ бесплатно: https://aistudio.google.com/apikey
#
#    По умолчанию стоит плавающий алиас gemini-flash-lite-latest: он всегда
#    указывает на актуальную lite-модель и не «протухает», когда Google
#    выводит конкретные версии из обращения.
#    Альтернативы: gemini-flash-latest (умнее, но по умолчанию «размышляет»:
#    медленнее и требует запаса maxOutputTokens), либо закреплённая версия
#    вроде gemini-3.5-flash-lite.
#    Список моделей, доступных именно вашему ключу:
#      curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#        https://generativelanguage.googleapis.com/v1beta/models
# --------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Управление «размышлениями» модели. По умолчанию (пусто) параметр не
# отправляется — это работает на любой модели. Формат зависит от поколения:
#   Gemini 2.5 — число, бюджет в токенах:  GEMINI_THINKING=0   (0 — выключить)
#   Gemini 3.x — уровень:                  GEMINI_THINKING=low
#                (minimal | low | medium | high)
# ВНИМАНИЕ: значение «не от того поколения» модель отвергнет с ошибкой
# 400 INVALID_ARGUMENT.
GEMINI_THINKING=

# Свой адрес API вместо стандартного. Нужен, только если Google отвечает
# «User location is not supported» — он блокирует IP-диапазоны многих
# хостингов. Укажите здесь адрес своего прокси в разрешённом регионе,
# например https://gemini-proxy.ваш-домен.workers.dev
# Пусто = обращаться напрямую к generativelanguage.googleapis.com
GEMINI_BASE_URL=

# Цепочки моделей: первая отвечает, остальные подхватывают при отказе
# (кончилась дневная квота, модель вывели из обращения). Перечисление
# через запятую, порядок важен.
#
# Зачем это в .env: Google регулярно переименовывает модели и закрывает
# старые версии, а точный список, доступный именно вашему ключу, виден
# только в AI Studio (https://aistudio.google.com/rate-limit). Если бот
# отвечает «модель недоступна» — поправьте здесь, пересобирать не нужно.
#
# main  — всё основное: разговор, картинки на вход, документы
# think — DEPRECATED, см. GEMINI_CHAIN_THINK ниже
#
# В хвосте обеих цепочек стоит прошлое поколение (2.5 Flash и Flash Lite,
# по 20 запросов в день): рабочей лошадью ему уже не быть, но как последняя
# страховка оно бесплатно и не мешает.
# draw  — вопросы перед рисованием. Намеренно лёгкая: задача формальная
#         (вернуть JSON), а человек ждёт. Замерено на одном запросе:
#         Gemma 31B — 25 секунд, flash-lite — полторы, вопросы те же.
# voice — голосовые сообщения на вход. Это та же main, из которой убрана
#         Gemma: звука она не слышит вовсе, и голосовое на ней срывалось бы
#         на первом же шаге. Никакой отдельной «расшифровки речи» бот не
#         покупает — запись уходит в модель обычным вложением, как картинка,
#         и считается по 32 токена за секунду (минута ≈ 2000 токенов).
#
# Потолок ответа в токенах для ответов В ЧАТ — по цепочке.
#
# Ответ в чат обязан уместиться в одно сообщение Telegram минус запас:
# режем по 3500 знаков (см. splitMarkdown), кириллица идёт примерно
# по 2,5 знака на токен — 3500 / 2,5 = 1400 токенов, минус 15% запаса
# (разметка разворачивается в теги, часть лимита уходит на мысли модели):
# 1400 × 0,85 = 1190, округлённо 1200. Отсюда и число.
#
# Ответ длиннее капа не теряется: длинный текст уезжает .md-файлом целиком.
# На умной цепочке при этом держится пол 4000 (contrib с меньшим отдаёт
# пустоту) — L1-ответы длиннее капа чаще уезжают файлом, это нормально.
#
# Есть и вторая причина держаться скромных чисел: минутная норма. В неё
# входит всё — и вопрос, и ответ, и история, — а у Gemma это 16 000 токенов
# в минуту на бесплатном тарифе.
#
# Если модель всё же не примет потолок, бот не покажет ошибку: он повторит
# запрос с тем пределом, который модель назвала в ответе.
#
GEMINI_MAX_OUTPUT_MAIN=1200
# Потолок бывшей команды «!контекст» (удалена). Ключ оставлен, чтобы старый
# .env не падал; код его больше не читает. Не удалять.
GEMINI_MAX_OUTPUT_THINK=8000

# Flash Lite ведёт все цепочки, кроме сильной: он отвечает за полторы секунды
# там, где Gemma думает 25, а при таймауте цепочка не перебирается. Gemma —
# последняя страховка в хвосте основной. Прошлое поколение (gemini-2.5-flash,
# gemini-2.5-flash-lite), которое раньше стояло под ней, убрано из всех
# цепочек 21.08.2026 — Google отдаёт по ним 404 «no longer available
# to new users», перебор впустую упирался в мёртвые звенья.
GEMINI_CHAIN_MAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it

# DEPRECATED: бывшая сильная цепочка «Подумать». Оставлена, чтобы старый .env
# не падал; бот её больше не читает — «!сеть», «!файл» и документы
# идут умной цепочкой (THINK_CHAIN в коде — алиас smart). Не удалять.
GEMINI_CHAIN_THINK=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.7-flash,gemma-4-31b-it

# DEPRECATED: бывшая цепочка задач-помощников. Оставлена, чтобы старый .env
# не падал; бот её больше не читает — быстрые задачи идут GEMINI_CHAIN_FAST
# ниже. Не удалять.
GEMINI_CHAIN_LIGHT=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.7-flash,gemma-4-31b-it
GEMINI_CHAIN_VOICE=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview

# Второй уровень быстрой цепочки (рисование, «!скажи», «!трек»): свой ключ,
# а не переиспользование MAIN — правится отдельно от разговорного хвоста.
# В resolveFastLevels список делится фильтром: всё, кроме Gemma, — L1
# (lite-голова), сама Gemma — L3 (последняя страховка). L2 между ними —
# OPENAI_CHAIN_FAST выше.
GEMINI_CHAIN_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it

# --------------------------------------------------------------------------
# 4. Любой OpenAI-совместимый провайдер (второй текстовый провайдер).
#    Подходят: OpenAI, OpenRouter, DeepSeek, Together, локальный Ollama и т.д.
#    Примеры BASE_URL:
#      https://api.openai.com/v1
#      https://openrouter.ai/api/v1
#      https://api.deepseek.com/v1
#      http://localhost:11434/v1        (Ollama)
#    Блок можно оставить пустым — тогда провайдер просто отключится.
# --------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Цепочки поверх провайдера выше (OpenRouter pay-as-you-go + Gemini-хвост).
# Чтобы завернуть их на OpenRouter: BASE_URL=https://openrouter.ai/api/v1
# и ключ OpenRouter в OPENAI_API_KEY. Пустой ключ = провайдер отключён,
# бот молча работает на чистом Gemini (второй уровень фолбэка).
#
# SMART — умная голова: contrib, запас luna. Дальше — Gemini-хвост из GEMINI_CHAIN_MAIN.
# FAST — быстрая (формальные JSON-планы: рисование, !скажи, !трек): L2 трёх
# уровней resolveFastLevels (L1 Gemini lite → L2 этот список → L3 Gemma).
# Порядок здесь — contrib, затем luna: точный плоский порядок владельца
# 3.5-lite → 3.1-lite → contrib → luna → gemma. Голосовые на OpenRouter
# не ходят (не проверены).
#
# TIMEOUT_MS 120с для умной: contrib отвечает 4–13с, vision — до 25с.
# MAX_OUTPUT_SMART 8000: contrib с маленьким потолком отдаёт пустоту —
# весь лимит съедают рассуждения (при 50 токенах ответ null). В коде
# дополнительно держится пол 4000 (см. resolveSmartLevels).
OPENAI_CHAIN_SMART=meta/muse-spark-1.3-contributor,openai/gpt-5.6-luna
OPENAI_CHAIN_FAST=meta/muse-spark-1.3-contributor,openai/gpt-5.6-luna
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_OUTPUT_SMART=8000
OPENAI_MAX_OUTPUT_FAST=2000

# Локальный сервер (LM Studio, Ollama и т.п.) обычно ключ не проверяет —
# но провайдер в боте считается настроенным только при непустом ключе,
# так что впишите сюда что угодно, например «local».

# --------------------------------------------------------------------------
# 5. OpenRouter — генерация картинок («/гем !нарисуй»). Одно из двух платных
#    мест в боте; второе — музыка через GoAPI, блок 6 ниже.
#
#    Бесплатно нарисовать нечем: у Google в колонке Free Tier все модели
#    генерации изображений помечены «Not available» — и Imagen, и нативные
#    Gemini Image. В веб-интерфейсе AI Studio картинки рисуются бесплатно,
#    но через API те же модели требуют биллинга; на этом обычно и путаются.
#
#    Ключ и баланс: https://openrouter.ai/keys
#    Пустой ключ = команда /draw просто отключится, остальной бот работает.
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Замерено на квадрате 1024x1024: krea-2-medium-turbo — $0,015 за картинку
# (около 66 на доллар), 17 секунд, png на 1,5 МБ. Прежняя gpt-image-1-mini
# была в семь раз дешевле ($0,0022) и вчетверо быстрее, но и рисовала проще.
#
# Наборы параметров у моделей разные, и лишнее поле — это 400. Что понимает
# конкретная модель, показывает её карточка в списке:
# https://openrouter.ai/api/v1/images/models
#
# Пустое значение = поле не уходит в запрос вовсе. Krea не знает ни QUALITY,
# ни FORMAT (отдаёт png), а RESOLUTION принимает единственную ступень — 1K.
# Для моделей OpenAI, наоборот: QUALITY=low, FORMAT=jpeg (при одинаковой цене
# файл в тридцать раз легче png), а RESOLUTION лучше оставить пустым —
# gpt-image-1-mini его игнорирует.
#
# ПРОПОРЦИЮ стоит задавать всегда: без неё модель выбирает форму сама. У моделей
# OpenAI от формы напрямую зависит цена — квадрат 1:1 даёт 1024x1024 и 272
# оплачиваемых токена ($0,0022, около 450 картинок на доллар), портрет
# и ландшафт — 400–408 токенов ($0,0033).
#
# ПРОПОРЦИЯ у Krea выбирается из списка 1:1, 4:3, 3:2, 16:9, 4:5, 2:3, 9:16 —
# скажем, привычной 3:4 в нём нет, и на неё придёт 400.
OPENROUTER_IMAGE_MODEL=krea/krea-2-medium-turbo
OPENROUTER_IMAGE_ASPECT_RATIO=4:5
# Из чего выбирать форму кнопками на экране подтверждения (первая строка выше —
# то, с чего начинается черновик). Список — ровно тот, что понимает модель:
# всё остальное она встретит ошибкой 400 уже после нажатия «Рисовать».
OPENROUTER_IMAGE_ASPECT_RATIOS=1:1,4:3,3:2,16:9,4:5,2:3,9:16
OPENROUTER_IMAGE_RESOLUTION=1K
OPENROUTER_IMAGE_QUALITY=
OPENROUTER_IMAGE_FORMAT=

# Дневная норма картинок на одного человека: 0 — снять ограничение.
# Норма общая для всех, включая админов: делится общий кошелёк. Рейт-лимит выше от перерасхода за вечер
# не спасает: он считает запросы в минуту. Счётчик лежит в SESSION_DIR
# и переживает рестарт.
#
# День календарный, по часовому поясу ниже: в контейнере время идёт по UTC,
# и без него норма обновлялась бы в три часа ночи по Москве.
IMAGE_DAILY_LIMIT=1
IMAGE_DAILY_LIMIT_TZ=Europe/Moscow

# Разговор перед рисованием: бот уточняет замысел кнопками и рисует только
# по подтверждению. Уточнения ведёт бесплатный Gemini (GEMINI_CHAIN_FAST),
# платная только картинка.
# DRAW_ASK_QUESTIONS=false вернёт старое поведение — рисовать сразу по команде.
#
# MAX_QUESTIONS — верхний потолок вопросов, которые модель вправе подготовить.
# Сколько из них реально задать (1..MAX_QUESTIONS) — выбирает сам человек
# слайдером на экране между замыслом и первым вопросом.
DRAW_ASK_QUESTIONS=true
DRAW_MAX_QUESTIONS=5
DRAW_DRAFT_TTL_MIN=30

# Куда доставлять параметры, которых нет в общем словаре OpenRouter (у Krea
# это creativity). Слаг виден в /api/v1/images/models/<модель>/endpoints.
# Пусто — такие параметры не отправляются.
OPENROUTER_IMAGE_PROVIDER_SLUG=krea

# Насколько модели позволено дописывать промпт за автора: raw|low|medium|high.
# Собственное умолчание Krea — medium, то есть она переписывает запрос всегда.
# Промпт, собранный в разговоре, по существу уже согласован — но пусть модель
# чуть-чуть доводит его сама (свет, мелкие детали), поэтому low, а не raw.
# Запрос «рисуй как есть» держится как раз на дорисовке — для него medium.
KREA_CREATIVITY_REFINED=low
KREA_CREATIVITY_PLAIN=medium

# --------------------------------------------------------------------------
# 6. GoAPI — музыка с вокалом («/гем !трек»). Второе и последнее платное
#    место в боте.
#
#    Почему не Google: музыку Gemini не пишет вовсе, а Lyria живёт в Vertex AI
#    — с биллингом и сервисным аккаунтом, то есть не тем ключом, которым
#    работает весь остальной бот. Ace-Step — открытая модель, и у посредника
#    она обходится дешевле всех остальных с вокалом: $0,0005 за секунду
#    готового звука, то есть $0,03 за минутный трек.
#
#    Ключ и баланс: https://goapi.ai (заголовок X-API-Key)
#    Пустой ключ = команда «!трек» просто отключится, остальной бот работает.
# --------------------------------------------------------------------------
GOAPI_API_KEY=
GOAPI_BASE_URL=https://api.goapi.ai

# Модель и тип задачи. У GoAPI эндпоинт один на все модели сервиса
# (POST /api/v1/task), а что делать — сказано этими двумя полями.
GOAPI_MUSIC_MODEL=Qubico/ace-step
GOAPI_MUSIC_TASK_TYPE=txt2audio

# Длительность в секундах: сколько просить, если человек не назвал своё время
# («полминуты», «секунд десять» — бот разберёт и переведёт в секунды).
#
# Это же и цена: платится секунда готового звука, а не запрос. Поэтому потолок
# выбран по кошельку, а не по пределу модели (240 секунд): 45 секунд стоят
# $0,0225, и стартовых полдоллара хватает на два десятка треков.
# Меньше 10 секунд модель не принимает.
#
# Число строк текста песни фиксированное (LYRICS_LINES в
# src/services/song-prompt.ts — сейчас 6-8), не растёт от длительности, —
# лишние секунды достаются повтору куплета/припева и проигрышу, а не тексту,
# который раньше не успевал спеться и обрывался.
# Вступление и концовка держатся короткими — 1 и 3 секунды, — но полем это
# не задаётся, только словами и тегами в запросе (см. INTRO_SECONDS,
# OUTRO_SECONDS в src/services/song-prompt.ts).
#
# Длительность по умолчанию равна потолку намеренно: будь она больше, каждый
# запрос молча урезался бы. Попросить дольше можно, такой запрос урежется,
# а настоящая длительность видна в подписи под треком.
TRACK_DURATION=45
TRACK_MAX_DURATION=45

# Дневная норма треков на человека: 0 — снять ограничение. Счёт отдельный
# от картинок — деньги и сервисы разные, — а часовой пояс по умолчанию тот же,
# что у картинок: две нормы с разными полуночами никому не объяснить.
TRACK_DAILY_LIMIT=1
TRACK_DAILY_LIMIT_TZ=

# Генерация асинхронная: сервис отдаёт task_id, бот сам спрашивает «готово?».
# Минуту музыки Ace-Step пишет за 20-40 секунд.
TRACK_POLL_MS=3000
TRACK_TIMEOUT_MS=300000

# «/гем где здесь ...» — УДАЛЕНА: рамки Robotics ER больше не используются,
# команда и код вычищены. Блок ниже оставлен пустым намеренно.

# Поиск по переписке раздела «/гем найди ...». Каждая реплика превращается
# в вектор и дописывается в архив (SEARCH_DIR, в Docker он на том же томе,
# что и сессии). Ищется по смыслу, а не по буквам.
#
# Норма у эмбеддингов 1000 запросов в день, поэтому реплики уходят пачками:
# запрос на десяток сообщений — это до десяти тысяч реплик в сутки.
#
# Порогов два, потому что у эмбеддингов высокий «пол»: несвязанные фразы
# дают заметную близость и одним порогом не отсекаются. MIN_SCORE отсекает
# по абсолютной величине, SCORE_GAP — всё, что слабее лучшей находки.
#
# Шкалы у моделей разные, поэтому и порог свой: MIN_SCORE относится
# к gemini-embedding-001, MIN_SCORE_E2 — ко второй версии. Замерено на одной
# переписке: верная находка получает 0,714 у первой и 0,571 у второй.
SEARCH_ENABLED=true
GEMINI_CHAIN_EMBED=gemini-embedding-2,gemini-embedding-001
SEARCH_DIR=data/search
SEARCH_DIMENSIONS=768
SEARCH_BATCH_SIZE=10
SEARCH_FLUSH_MS=30000
SEARCH_MIN_CHARS=15
SEARCH_MAX_RECORDS=3000
SEARCH_TOP_K=5
SEARCH_MIN_SCORE=0.62
SEARCH_MIN_SCORE_E2=0.50
SEARCH_SCORE_GAP=0.08

# Файлы от бота («/гем !файл ...»). Умолчание — Markdown, а не txt: модель
# пишет разметкой, и в простом тексте звёздочки с решётками стали бы мусором.
# Формат можно назвать первым словом: «!файл html дашборд продаж».
FILE_DEFAULT_FORMAT=md
# «!файл ...» — модель пишет само содержимое: смету, страницу, выгрузку.
# 16 000 токенов — это «подумать, сделать и выдать» в одном проходе: HTML
# с таблицами и SVG-графиком на русском весит 8–12 тысяч токенов.
# На первом уровне умной цепочки действует потолок OpenRouter
# (OPENAI_MAX_OUTPUT_SMART=8000): полный объём отдаёт Gemini-хвост.
FILE_MAX_OUTPUT_TOKENS=16000
# Длинный ответ, уехавший файлом (перерос сообщение в чате, развёрнутое
# «!размышление»). Здесь наоборот: файла просят ровно тогда, когда нужен
# разбор на много страниц.
FILE_ANSWER_MAX_OUTPUT_TOKENS=48000

# Предел на присланный файл, в токенах. 0 — без ограничения (решение
# владельца). ВНИМАНИЕ: без предела минутная норма Gemini (16 000
# токенов/мин на бесплатном тарифе) съедается одним толстым файлом целиком.
# Прежде было 150000 (≈450 КБ текста или 230 страниц): на бесплатном ключе
# разумно держать столько, на платном можно не ограничивать.
DOC_MAX_TOKENS=0

# Озвучка «/гем скажи ...». Дневная норма у TTS-моделей маленькая — по 10
# запросов на каждую, — поэтому здесь тоже цепочка с подхватом при отказе.
# Плюс личная норма бота (TTS_DAILY_LIMIT), чтобы один человек не выбирал
# общий запас в одиночку. Голос выбирается из набора Google: Kore, Puck,
# Charon, Aoede и другие.
#
# Telegram принимает голосовые только в OGG/Opus, а Gemini отдаёт сырой PCM.
# Есть ffmpeg — бот перекодирует и пришлёт голосовое; нет — пришлёт WAV
# обычным аудиофайлом (в образе ffmpeg уже стоит, см. Dockerfile).
GEMINI_CHAIN_TTS=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts
# Голос по умолчанию из набора Google — Charon, средний мужской без окраски.
# Разовый выбор — своими словами или кавычками в команде: «/гем !скажи
# «низкий» привет». Слова-голоса: мужской, женский, низкий, высокий, бодрый,
# твёрдый, мягкий, яркий, напористый, уверенный; всё прочее модель понимает
# как манеру («шёпотом», «как в Warcraft 3»).
GEMINI_TTS_VOICE=Charon
TTS_MAX_CHARS=900
# Озвучек в день на человека (0 — снять ограничение). Счёт отдельный.
TTS_DAILY_LIMIT=5
TTS_DAILY_LIMIT_TZ=

# --------------------------------------------------------------------------
# 6. Прочее
# --------------------------------------------------------------------------
# Telegram ID администраторов через запятую (узнать свой: команда /whoami).
# Админы не ограничиваются рейт-лимитом, видят расширенный /status и могут
# обнулять людям дневные нормы: «/гем !resetuser @ник», «!resetuser self»
# или «!resetuser» реплаем. В /help этой команды нет намеренно.
ADMIN_IDS=

# Ограничение частоты запросов: не более RATE_LIMIT_MAX сообщений
# за RATE_LIMIT_WINDOW_MS миллисекунд от одного пользователя.
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW_MS=60000

# Дневная норма сообщений боту на человека (0 — снять ограничение).
# Это «не больше за день» (календарный, пояс ниже), а RATE_LIMIT_MAX выше —
# «не чаще раза в минуту». Обычный «/гем» денег не стоит, но бесплатная
# норма Gemini общая на всю группу.
MESSAGES_DAILY_LIMIT=50
MESSAGES_DAILY_LIMIT_TZ=

# Сколько сообщений диалога помнить в контексте (0 — не помнить).
# Пятнадцать — живой хвост разговора (семь-восемь обменов): хватает
# на «он же только что сказал», но не тащит в каждый запрос вчерашний день.
# Хранить при этом стоит больше (HISTORY_MAX_TOKENS=10000, ~100 средних реплик,
# файл сессии порядка 50–100 КБ): что дальше хвоста — ищется «!найди»
# или помнится долгой выжимкой раздела (DIGEST_* ниже).
HISTORY_MAX_TOKENS=10000
HISTORY_SEND=15

# Долгая память раздела: скользящая выжимка переписки поверх HISTORY_SEND.
# Раз в DIGEST_BATCH_SIZE реплик модель сливает накопленное с прежней
# выжимкой в одну обновлённую — размер не растёт, сколько бы времени
# ни прошло, — и та едет в каждый обычный ответ сама, без команды.
# Считает не «живая» модель чата, а отдельная и медленная (по умолчанию
# Gemma) — фоново, после ответа человеку, задержки не добавляет.
DIGEST_ENABLED=true
DIGEST_MODEL=gemma-4-31b-it
DIGEST_BATCH_SIZE=50
DIGEST_MAX_CHARS=9000
DIGEST_MAX_OUTPUT_TOKENS=3000
DIGEST_MIN_CHARS=15

# DEPRECATED: спонтанные реплики отключены по решению владельца (wiring убран,
# код SPONTANEOUS_* больше не читает). Ключи оставлены, чтобы старый .env
# не падал. Не удалять.
#
# Спонтанные реплики: раз в день, в случайное время, бот сам пишет одну
# короткую реплику в раздел — без вопроса и без команды. Требует включённый
# архив поиска (SEARCH_ENABLED=true): реплика опирается на последние реплики
# раздела, а не на пересказ пересказа.
SPONTANEOUS_ENABLED=true
SPONTANEOUS_MODEL=gemini-3.5-flash-lite
# Случайное время — внутри этого диапазона часов (не ночью).
SPONTANEOUS_WINDOW_START=11
SPONTANEOUS_WINDOW_END=23
# Часовой пояс диапазона выше. Не задан — берётся IMAGE_DAILY_LIMIT_TZ.
SPONTANEOUS_TZ=
# Вероятность вообще написать сегодня — на каждый раздел отдельно.
SPONTANEOUS_CHANCE=0.65
# Вероятность (при том, что пишем) уйти в «вывод по долгой памяти» вместо
# реакции на последние сообщения — редко: риск ошибиться там выше.
SPONTANEOUS_DEEP_CHANCE=0.15
# Вероятность (при «глубоком» жанре) подать вывод шуткой, а не всерьёз.
SPONTANEOUS_JOKE_CHANCE=0.3
# Вероятность взять манеру речи одного из участников последних сообщений.
SPONTANEOUS_IMPERSONATE_CHANCE=0.12
SPONTANEOUS_RECENT_LIMIT=50
# Меньше этого реплик в разделе — значит, почти не говорили, повода нет.
SPONTANEOUS_MIN_RECENT=6
SPONTANEOUS_MAX_OUTPUT_TOKENS=300

# Таймаут одного запроса к нейросети, мс
AI_TIMEOUT_MS=90000

# Свой, более щедрый таймаут для «!сеть» — 120 секунд: Tavily ждём до 90с
# (см. AI_TIMEOUT_MS выше), остальное — запас на два быстрых прохода
# web-уровней (голова-luna отвечает за ~1с, хвост — lite). Прежних 150с было
# много: они остались от времён медленной головы на весе поисковых страниц.
WEB_TIMEOUT_MS=120000

# Потолки ответа «!сеть» по проходам (см. searchWithTavily в src/commands/ai.ts).
# Вход первого прохода — 5 страниц Tavily по ~4000 знаков (≈8000 токенов):
# выжимке по ним нужно место развернуться, отсюда 4000. Второй проход пишет
# одно сообщение Telegram минус 15% запаса: 3500 знаков / 2,5 ≈ 1400 токенов
# (та же арифметика, что у GEMINI_MAX_OUTPUT_MAIN=1200, но без округления вниз —
# ответ метит почти в границу сообщения, остаток займут источники).
WEB_DIGEST_MAX_OUTPUT_TOKENS=4000
WEB_FINAL_MAX_OUTPUT_TOKENS=1400

# Где хранить сессии: историю диалогов и настройки разделов форума.
# Путь относительный — считается от рабочего каталога процесса.
# ВАЖНО: в Docker этот каталог обязан лежать на томе, иначе пересоздание
# контейнера сбросит настройки всех разделов. В docker-compose том уже описан.
SESSION_DIR=data/sessions

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# --------------------------------------------------------------------------
# Tavily — ОСНОВНОЙ путь живого поиска, и он бесплатный.
#
# Это поисковый сервис, а не нейросеть: он отдаёт страницы, а ответ по ним
# пишет обычная цепочка Gemini — та же, что отвечает на любой вопрос. Значит
# денег поиск не стоит вовсе: тратится кредит из пакета (в бесплатном их 1000,
# по одному за обычный поиск) и бесплатная дневная норма Google.
#
# Ключ и остаток кредитов: https://app.tavily.com
# Пусто — не поломка: поиск сразу пойдёт платным путём через OpenRouter.
#
# DEPTH: basic — один кредит, advanced — два. Разница нужна на длинных
# исследовательских запросах, которых в групповом чате не бывает.
#
# PAGE_CHARS: сколько знаков брать с каждой найденной страницы. Обычная
# выдача Tavily — выжимка в несколько строк, и на пять страниц набирается
# тысячи две знаков: развёрнутый ответ писать не из чего. Поэтому просим
# и полный текст страницы, но обрезаем его до этого числа — целиком статья
# бывает и в сто тысяч знаков, а весь запрос уходит в модель разом.
# 4000 на страницу — это около 1600 токенов, пять страниц весят примерно
# 8000: флеши берут такое спокойно. Кредитов не добавляет: платится
# за поиск, а не за объём текста. Ноль — вернуться к одним выжимкам.
# --------------------------------------------------------------------------
TAVILY_API_KEY=
# Пять простых источников за один кредит: deep-разбору (advanced/20) большой
# поиск не нужен, сводка в чат пишется из пяти выжимок.
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_PAGE_CHARS=4000

# --------------------------------------------------------------------------
# Запасной платный путь живого поиска через OpenRouter — ОТКЛЮЧЁН (21.08.2026):
# «/гем !сеть ...» ходит только через Tavily выше, без запасного пути.
# Переменные ниже код больше не читает (ENGINE — deprecated, игнор),
# оставлены на случай, если путь вернут: см. handleWeb в src/commands/ai.ts.
# --------------------------------------------------------------------------
OPENROUTER_WEB_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_WEB_ENGINE=parallel
OPENROUTER_WEB_MAX_RESULTS=20

# --------------------------------------------------------------------------
# Долгое размышление над одним вопросом («/гем !размышление ...») — тот же
# ключ OpenRouter, четвёртое место, где бот тратит деньги.
#
# Чем отличается от «!контекста»: тот бесплатный (Gemini) и разбирает задачу
# внутри разговора, с историей раздела. Здесь наоборот — платная модель,
# которой дают время подумать перед ответом, и вопрос уходит «голым», без
# истории вовсе: с контекстом модель отвечает разговору, а не вопросу.
#
# MODEL — алиас головы цепочки ради совместимости со старым .env.
# CHAIN — сама цепочка: первая отвечает, остальные подхватывают при отказе
#   (кончилась квота, модель вывели из обращения, сбой провайдера).
#   Порядок важен, перечисление через запятую. По умолчанию contrib голова,
#   luna запас: contrib рассуждает по-русски живее, luna дешевле и держит
#   ответ, когда голова недоступна.
# Если DEEP_MODEL задан (непуст) — он голова, дальше хвост DEEP_CHAIN без
# дублей; если пуст — целиком DEEP_CHAIN. Старый .env с одним
# DEEP_MODEL=openai/gpt-5.6-luna продолжает работать: голова luna,
# запас contrib.
#
# Кандидаты и цены:
#   meta/muse-spark-1.3-contributor — голова по умолчанию, живой русский;
#   openai/gpt-5.6-luna        $0,20 / $1,20 за миллион;
#                              на max держит индекс 52 против 53 у DeepSeek
#                              и пишет по-русски живо, а не тезисами;
#   openai/gpt-5.6-luna-pro    та же цена за токен, но токенов тратит
#                              вчетверо больше и не соблюдает MAX_TOKENS —
#                              при потолке 20 000 выдала 46 000. Ответ при
#                              этом той же длины: брать незачем;
#   deepseek/deepseek-v4-pro-0813  $0,66 / $1,98 — индекс 53, но по-русски
#                              суше; голый slug без даты — апрельская 0423,
#                              её никто не мерил;
#   anthropic/claude-sonnet-5  $2 / $10;
#   anthropic/claude-opus-5    $5 / $25 — если не жалко.
#
# EFFORT: доля бюджета, уходящая на размышление (high ≈ 0,8, max ≈ 0,95).
# Доля делит не качество, а место: что не ушло на мысли, остаётся ответу.
# На max ответу достаётся 5% — при 20 000 это около 1000 токенов, и вопрос
# с длинным ответом по существу (расписание на неделю, план по пунктам)
# обрывается на первом же пункте: замер дал 18 500 мыслей из 20 000.
# Поэтому high при поднятом потолке: мыслям те же 19 200, ответу 4800
# вместо 1000. Пять пунктов индекса у Luna (47 против 52) стоят дешевле,
# чем оборванный ответ.
#
# MAX_TOKENS: потолок на размышление и ответ разом, он же потолок цены.
# Именно потолок, а не заказ: платится то, что модель написала на самом деле.
# 24 000 у Luna — это максимум 2,9 цента за вопрос. Замер на живом вопросе:
# 13 500 токенов мыслей, 2 500 тексту, 9 300 знаков ответа, 1,9 цента.
#
# TIMEOUT_MS: своё ожидание, впятеро больше общего AI_TIMEOUT_MS: думает
# модель минуты, а не секунды. На каждую попытку отдельно, а не на цепочку:
# голова думает долго, и общий бюджет обрезал бы запасную ровно тогда,
# когда голова съела время впустую.
# --------------------------------------------------------------------------
DEEP_MODEL=
DEEP_CHAIN=meta/muse-spark-1.3-contributor,openai/gpt-5.6-luna
DEEP_EFFORT=high
DEEP_MAX_TOKENS=24000
DEEP_TIMEOUT_MS=300000

# Подвозить ли модели свежие страницы перед размышлением (on|off).
# Знания модели кончаются задолго до сегодня, и на вопросе про недавнее
# рассуждение получается глубоким и устаревшим разом. Поэтому бот сперва
# ищет страницы в Tavily и кладёт их в тот же запрос, а в промпт ставит
# настоящую сегодняшнюю дату.
#
# Почему Tavily, а не поисковый плагин OpenRouter (parallel $0,001,
# perplexity $0,005, exa $0,007 за запрос): кредиты Tavily уже куплены,
# и в них входит полный текст страниц (TAVILY_PAGE_CHARS), а плагины отдают
# выжимки. Для размышления материал важнее: думать по выжимке — думать
# по заголовкам. Стоит это одного кредита и ~8000 входных токенов, то есть
# полцента. off — вернуться к чистому размышлению по памяти.
DEEP_SEARCH=on

# Профиль поиска для размышления — нарочно щедрее, чем у «!сети».
# Само размышление стоит рубль-другой, и экономить на материале, по которому
# оно идёт, — экономить не там.
#
# DEPTH advanced: выдача точнее, 2 кредита Tavily вместо одного.
# RESULTS 20: вчетверо больше, чем у «!сети», и за поиск платят, а не за длину
#             выдачи. Это же потолок Tavily — больше 20 он не отдаёт.
# PAGE_CHARS 6000: больше текста с каждой страницы, чем TAVILY_PAGE_CHARS.
#
# Итого вопрос обходится примерно в 2-3 ₽ вместо рубля, а кредитов уходит
# по два. Их 1000, и при норме 2 размышления в день на шестерых это 24
# в день сверх обычного поиска.
#
# Расплываются ответы — уменьшать RESULTS первым; мало фактов — уже некуда,
# тогда резать PAGE_CHARS.
DEEP_SEARCH_DEPTH=advanced
DEEP_SEARCH_RESULTS=20
DEEP_SEARCH_PAGE_CHARS=6000

# Дневная норма размышлений на человека: 0 — снять ограничение. Счёт отдельный
# от картинок, треков и поиска — деньги и сервисы разные.
DEEP_DAILY_LIMIT=2

# Поисков в день на человека (0 — снять ограничение). Счёт отдельный
# от картинок и треков: деньги разные. Пять поисков на шестерых — это
# чуть больше десятка центов в день, и то если каждый выберет норму до конца.
WEB_DAILY_LIMIT=5
